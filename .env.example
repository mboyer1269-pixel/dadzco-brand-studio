# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>

# Auth redirect
# Set this to your production domain in Vercel (and any staging environments).
# Without this, magic links fall back to window.location.origin, which will be
# localhost when the link is requested from a local dev session.
# Must match the Site URL configured in:
#   Supabase Dashboard → Authentication → URL Configuration
VITE_SITE_URL=https://your-production-domain.com
